
{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "tags": [
        "ci"
      ]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "tags": [
        "ci"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "tags": [
        "ci"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
